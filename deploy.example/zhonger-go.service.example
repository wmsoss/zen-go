[Unit]
Description=zhonger-go: Go application layer
After=network.target

[Service]
Type=simple
User=zhonger
Group=zhonger
WorkingDirectory=/opt/zhonger
EnvironmentFile=/etc/zhonger/zhonger.env
ExecStart=/opt/zhonger/zhonger-go
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
